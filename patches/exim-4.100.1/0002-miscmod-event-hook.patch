+
+/* Notify synchronous listeners without changing event_action or errno.
+Callbacks must not retain the borrowed strings or raise recursive events. */
+
+void
+misc_mod_event(const uschar * event, const uschar * data)
+{
+int saved_errno = errno;
+for (const misc_module_info * mi = misc_module_list; mi; mi = mi->next)
+  if (mi->event)
+    {
+    errno = saved_errno;
+    (mi->event)(event, data);
+    }
+errno = saved_errno;
 }
 
